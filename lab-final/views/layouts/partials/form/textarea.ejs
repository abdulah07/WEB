<% /*
Props:
  id, name, label - required
  value (string) - optional
  rows (number) - optional, default 4
  placeholder, help, error, required - optional
*/ %>
<div class="form-field">
  <label class="form-label" for="<%= id %>">
    <%= label %>
    <% if (required) { %><span aria-hidden="true" class="text-muted"> *</span><% } %>
  </label>
  <textarea
    class="form-input <%= error ? 'form-input-error' : '' %>"
    id="<%= id %>"
    name="<%= name %>"
    rows="<%= typeof rows !== 'undefined' ? rows : 4 %>"
    placeholder="<%= typeof placeholder !== 'undefined' ? placeholder : '' %>"
    <%= required ? 'required' : '' %>
    aria-invalid="<%= error ? 'true' : 'false' %>"
    aria-describedby="<%= [help ? id + '-help' : '', error ? id + '-error' : ''].filter(Boolean).join(' ') %>"
  ><%= typeof value !== 'undefined' ? value : '' %></textarea>
  <% if (help && !error) { %>
    <div id="<%= id %>-help" class="form-help"><%= help %></div>
  <% } %>
  <% if (error) { %>
    <div id="<%= id %>-error" class="form-error" role="alert"><%= error %></div>
  <% } %>
</div>
