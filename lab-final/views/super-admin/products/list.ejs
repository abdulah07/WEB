<div class="cart-header" style="margin-bottom: var(--space-4);">
  <h1 class="heading-2">All Products</h1>
  <div class="cart-header-actions">
    <a href="/super-admin/products/create" class="btn btn-primary">
      <svg class="icon icon--sm"><use href="/icons.svg#plus"></use></svg>
      Create New Product
    </a>
  </div>
</div>

<div class="card" style="padding: 0; overflow-x: auto;">
  <table style="width: 100%; border-collapse: collapse;">
    <thead>
      <tr style="background: var(--color-gray-100); border-bottom: 2px solid var(--color-gray-300);">
        <th style="padding: var(--space-3); text-align: left; font-weight: 600; color: var(--color-black);">Image</th>
        <th style="padding: var(--space-3); text-align: left; font-weight: 600; color: var(--color-black);">Name</th>
        <th style="padding: var(--space-3); text-align: left; font-weight: 600; color: var(--color-black);">Department</th>
        <th style="padding: var(--space-3); text-align: left; font-weight: 600; color: var(--color-black);">Color</th>
        <th style="padding: var(--space-3); text-align: left; font-weight: 600; color: var(--color-black);">Price</th>
        <th style="padding: var(--space-3); text-align: left; font-weight: 600; color: var(--color-black);">Description</th>
        <th style="padding: var(--space-3); text-align: left; font-weight: 600; color: var(--color-black);">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% products.forEach(product => { %>
        <tr style="border-bottom: 1px solid var(--color-gray-200);">
          <td style="padding: var(--space-3);">
            <% if (product.image) { %>
              <img src="/images/uploaded/<%= product.image %>" alt="<%= product.name %>" style="width: 60px; height: 60px; object-fit: cover; border-radius: var(--radius-sm);">
            <% } else { %>
              <span style="color: var(--color-black-50);">N/A</span>
            <% } %>
          </td>
          <td style="padding: var(--space-3);"><%= product.name %></td>
          <td style="padding: var(--space-3); color: var(--color-black-70);"><%= product.department %></td>
          <td style="padding: var(--space-3); color: var(--color-black-70);"><%= product.color %></td>
          <td style="padding: var(--space-3); font-weight: 600;">$<%= product.price %></td>
          <td style="padding: var(--space-3); color: var(--color-black-60); max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= product.description %></td>
          <td style="padding: var(--space-3);">
            <div style="display: flex; gap: var(--space-2);">
              <a href="/super-admin/products/edit/<%= product._id %>" class="btn btn-ghost" style="font-size: var(--font-size-sm); padding: var(--space-1) var(--space-2);">Edit</a>
              <a href="/super-admin/products/delete/<%= product._id %>" class="btn btn-ghost" style="font-size: var(--font-size-sm); padding: var(--space-1) var(--space-2); color: var(--color-red-600);" onclick="return confirm('Are you sure you want to delete this product?');">Delete</a>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
