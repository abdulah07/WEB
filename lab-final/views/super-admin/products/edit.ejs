<div class="cart-header" style="margin-bottom: var(--space-4);">
  <h1 class="heading-2">Edit Product</h1>
  <div class="cart-header-actions">
    <a href="/super-admin/products" class="btn btn-ghost">
      <svg class="icon icon--sm"><use href="/icons.svg#chevron-left"></use></svg>
      Back to Products
    </a>
  </div>
</div>

<div class="card" style="padding: var(--space-4); max-width: 600px;">
  <form action="/super-admin/products/edit/<%= product._id %>" method="POST" enctype="multipart/form-data">
    <%- include('../../layouts/partials/form/input', {
      id: 'name',
      name: 'name',
      label: 'Product Name',
      type: 'text',
      value: product.name,
      error: '',
      help: '',
      required: true
    }) %>

    <%- include('../../layouts/partials/form/input', {
      id: 'price',
      name: 'price',
      label: 'Price',
      type: 'text',
      value: product.price,
      error: '',
      help: 'Enter price in dollars (e.g., 29.99)',
      required: true
    }) %>

    <%- include('../../layouts/partials/form/input', {
      id: 'color',
      name: 'color',
      label: 'Color',
      type: 'text',
      value: product.color || '',
      error: '',
      help: '',
      required: false
    }) %>

    <%- include('../../layouts/partials/form/input', {
      id: 'department',
      name: 'department',
      label: 'Department',
      type: 'text',
      value: product.department || '',
      error: '',
      help: '',
      required: false
    }) %>

    <%- include('../../layouts/partials/form/textarea', {
      id: 'description',
      name: 'description',
      label: 'Description',
      value: product.description || '',
      error: '',
      help: '',
      rows: 4,
      required: false
    }) %>

    <div class="form-field">
      <label class="form-label">Current Image</label>
      <% if (product.image) { %>
        <img src="/images/uploaded/<%= product.image %>" alt="Product Image" style="width: 150px; height: 150px; object-fit: cover; border-radius: var(--radius-md); margin-top: var(--space-2);">
      <% } else { %>
        <p style="color: var(--color-black-50); margin-top: var(--space-2);">No image uploaded.</p>
      <% } %>
    </div>

    <div class="form-field">
      <label class="form-label" for="image">Change Image</label>
      <input type="file" name="image" id="image" class="form-input" accept="image/*" />
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Update Product</button>
      <a href="/super-admin/products" class="btn btn-ghost">Cancel</a>
    </div>
  </form>
</div>
  