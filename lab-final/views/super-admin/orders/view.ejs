<div class="cart-header" style="margin-bottom: var(--space-4);">
  <h1 class="heading-2">Order Details</h1>
  <div class="cart-header-actions">
    <a href="/super-admin/orders" class="btn btn-ghost">
      <svg class="icon icon--sm"><use href="/icons.svg#chevron-left"></use></svg>
      Back to Orders
    </a>
  </div>
</div>

<div class="row" style="display: flex; gap: var(--space-6); flex-wrap: wrap;">
  <!-- Left Column: Order Info & Items -->
  <div style="flex: 1 1 600px;">
    
    <!-- Order Status Card -->
    <div class="card" style="padding: var(--space-4); margin-bottom: var(--space-6);">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-4);">
        <div>
          <h2 class="heading-4" style="margin: 0;">Order #<%= order._id %></h2>
          <p style="color: var(--color-muted); margin: 0;"><%= new Date(order.createdAt).toLocaleString() %></p>
        </div>
        <span style="
          padding: 4px 12px; 
          border-radius: var(--radius-round); 
          font-weight: 600; 
          text-transform: uppercase;
          background-color: <%= order.status === 'pending' ? '#fff7ed' : (order.status === 'completed' ? '#f0fdf4' : '#f3f4f6') %>;
          color: <%= order.status === 'pending' ? '#c2410c' : (order.status === 'completed' ? '#15803d' : '#4b5563') %>;
        ">
          <%= order.status %>
        </span>
      </div>

      <form action="/super-admin/orders/<%= order._id %>/status" method="POST" class="form-inline" style="align-items: flex-end;">
        <%- include('../../layouts/partials/form/select', {
          id: 'status',
          name: 'status',
          label: 'Update Status',
          value: order.status,
          options: [
            { value: 'pending', label: 'Pending' },
            { value: 'paid', label: 'Paid' },
            { value: 'shipped', label: 'Shipped' },
            { value: 'completed', label: 'Completed' },
            { value: 'cancelled', label: 'Cancelled' }
          ],
          error: '',
          help: '',
          required: true
        }) %>
        <button type="submit" class="btn btn-primary" style="margin-bottom: var(--space-6);">Update</button>
      </form>
    </div>

    <!-- Order Items -->
    <div class="card" style="padding: 0; overflow: hidden;">
      <div style="padding: var(--space-4); border-bottom: 1px solid var(--color-gray-200);">
        <h3 class="heading-4" style="margin: 0;">Items</h3>
      </div>
      <table style="width: 100%; border-collapse: collapse;">
        <thead>
          <tr style="background: var(--color-gray-100);">
            <th style="padding: var(--space-3); text-align: left;">Product</th>
            <th style="padding: var(--space-3); text-align: center;">Qty</th>
            <th style="padding: var(--space-3); text-align: right;">Price</th>
            <th style="padding: var(--space-3); text-align: right;">Total</th>
          </tr>
        </thead>
        <tbody>
          <% order.items.forEach(item => { %>
            <tr style="border-bottom: 1px solid var(--color-gray-100);">
              <td style="padding: var(--space-3);">
                <div style="font-weight: 600;"><%= item.name %></div>
              </td>
              <td style="padding: var(--space-3); text-align: center;"><%= item.quantity %></td>
              <td style="padding: var(--space-3); text-align: right;">$<%= item.price %></td>
              <td style="padding: var(--space-3); text-align: right;">$<%= item.subtotal %></td>
            </tr>
          <% }) %>
        </tbody>
        <tfoot>
          <tr>
            <td colspan="3" style="padding: var(--space-3); text-align: right; font-weight: 600;">Subtotal:</td>
            <td style="padding: var(--space-3); text-align: right;">$<%= order.subtotalAmount %></td>
          </tr>
          <tr>
            <td colspan="3" style="padding: var(--space-3); text-align: right; color: var(--color-muted);">Shipping:</td>
            <td style="padding: var(--space-3); text-align: right;">$<%= order.shippingAmount %></td>
          </tr>
          <tr>
            <td colspan="3" style="padding: var(--space-3); text-align: right; color: var(--color-muted);">Tax:</td>
            <td style="padding: var(--space-3); text-align: right;">$<%= order.taxAmount %></td>
          </tr>
          <tr style="background: var(--color-gray-100);">
            <td colspan="3" style="padding: var(--space-3); text-align: right; font-weight: 700; font-size: var(--font-size-lg);">Total:</td>
            <td style="padding: var(--space-3); text-align: right; font-weight: 700; font-size: var(--font-size-lg); color: var(--color-accent);">$<%= order.totalAmount %></td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>

  <!-- Right Column: Customer Details -->
  <div style="flex: 1 1 300px; min-width: 300px;">
    <div class="card" style="padding: var(--space-4);">
      <h3 class="heading-4" style="margin-bottom: var(--space-4);">Customer Details</h3>
      
      <div style="margin-bottom: var(--space-4);">
        <h4 class="heading-6" style="color: var(--color-muted); margin-bottom: var(--space-1);">Name</h4>
        <p><%= order.shippingAddress ? order.shippingAddress.fullName : 'N/A' %></p>
      </div>

      <div style="margin-bottom: var(--space-4);">
        <h4 class="heading-6" style="color: var(--color-muted); margin-bottom: var(--space-1);">Email</h4>
        <p><%= order.user ? order.user.email : 'Guest Checkout' %></p>
      </div>

      <div style="margin-bottom: var(--space-4);">
        <h4 class="heading-6" style="color: var(--color-muted); margin-bottom: var(--space-1);">Shipping Address</h4>
        <% if (order.shippingAddress) { %>
          <p>
            <%= order.shippingAddress.line1 %><br>
            <% if (order.shippingAddress.line2) { %><%= order.shippingAddress.line2 %><br><% } %>
            <%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> <%= order.shippingAddress.postalCode %><br>
            <%= order.shippingAddress.country %>
          </p>
        <% } else { %>
          <p>N/A</p>
        <% } %>
      </div>

      <div>
        <h4 class="heading-6" style="color: var(--color-muted); margin-bottom: var(--space-1);">Payment Method</h4>
        <p><%= order.paymentMethod || 'Not specified' %></p>
      </div>
    </div>
  </div>
</div>
