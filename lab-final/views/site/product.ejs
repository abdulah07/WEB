<section class="productPage" style="width:100%;">
  <div class="container" style="margin-top: var(--space-6);">
    <div style="margin-bottom: var(--space-4);">
      <a href="/" class="btn btn-ghost">
        <svg class="icon icon--sm"><use href="/icons.svg#chevron-left"></use></svg>
        Back to Homepage
      </a>
    </div>

    <div class="product-layout" style="display:flex; flex-wrap:nowrap; gap: var(--space-6); align-items:flex-start;">
      <div style="flex: 0 0 40%; max-width: 40%;">
        <% if (product.image) { %>
          <img 
            src="/images/uploaded/<%= product.image %>" 
            alt="<%= product.title || product.name %>" 
            style="width:100%; height:auto; border-radius: var(--radius-md);" />
        <% } else { %>
          <div style="background:#eee; width:100%; padding-top: 75%; border-radius: var(--radius-md); display:flex; align-items:center; justify-content:center; color:#999;">
            No Image
          </div>
        <% } %>
      </div>

      <div style="flex: 1 1 60%; max-width: 60%;">
        <div class="box" style="padding: var(--space-4);">
          <h2 style="margin: 0 0 var(--space-3); font-family: var(--font-sans-strong);">
            <%= product.title || product.name %>
          </h2>
          <div style="color: var(--color-black-60); margin-bottom: var(--space-3);">
            <% if (product.department) { %>
              <span><strong>Department:</strong> <%= product.department %></span>
            <% } %>
            <% if (product.color) { %>
              <span style="margin-left: var(--space-3);"><strong>Color:</strong> <%= product.color %></span>
            <% } %>
          </div>
          <div style="font-size: var(--font-size-xl); font-weight: 600; margin-bottom: var(--space-3);">
            $<%= product.price %>
          </div>

          <% if (product.description) { %>
            <p style="line-height: 1.6;">
              <%= product.description %>
            </p>
          <% } else { %>
            <p style="color: var(--color-black-50);">No description available.</p>
          <% } %>

          <div style="margin-top: var(--space-4); display:flex; gap: var(--space-3);">
            <a href="/add-cart/<%= product._id %>" class="btn btn-secondary">Add To Cart</a>
            <a href="/" class="btn btn-ghost">Back to Homepage</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
