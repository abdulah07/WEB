<section class="container order-confirmation-section">
  <div class="text-center" style="padding: 4rem 0;">
    <svg xmlns="http://www.w3.org/2000/svg" class="text-success mb-4" width="64" height="64" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <h1 class="heading-2 mb-3">Order Confirmed!</h1>
    <p class="lead mb-4">Thank you for your purchase. Your order has been successfully placed.</p>
    
    <div class="card mx-auto mb-5" style="max-width: 500px;">
      <div class="card-body">
        <h5 class="card-title text-muted mb-2">Order ID</h5>
        <p class="display-6 fw-bold text-primary"><%= order._id %></p>
      </div>
    </div>

    <div class="d-flex justify-content-center gap-3">
      <a href="/" class="btn btn-primary">Continue Shopping</a>
    </div>
  </div>
</section>
